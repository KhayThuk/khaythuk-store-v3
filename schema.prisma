datasource db {
  provider = "postgresql"
url = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id        String       @id @default(cuid())
  name      String       @unique
  products  Product[]
  createdAt DateTime     @default(now())
}

model Product {
  id          String       @id @default(cuid())
  title       String       
  categoryId  String
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  duration    String       
  price       Float        
  digitalData String       
  expiresAt   DateTime?    
  createdAt   DateTime     @default(now())
}